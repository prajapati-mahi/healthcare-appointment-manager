# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/healthcare_app"

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET="your-very-strong-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORSORIGIN=http://localhost:5173

# ─── Redis (BullMQ background jobs) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email (Nodemailer) ──────────────────────────────────────────────────────
# For development: Use https://ethereal.email (free, no real emails sent)
# For production: Use your SMTP provider (SendGrid, AWS SES, Mailgun, etc.)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your.ethereal.user@ethereal.email
EMAIL_PASS=your-ethereal-password
EMAIL_FROM="HealthCare App <noreply@healthcare.dev>"

# ─── LLM / AI (OpenAI) ────────────────────────────────────────────────────
# Get your key from https://platform.openai.com/api-keys
LLM_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o-mini

# ─── Google Calendar OAuth 2.0 ────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable Google Calendar API and create OAuth 2.0 Client ID (Web application)
# Add http://localhost:5000/api/calendar/callback to Authorized redirect URIs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# ─── Worker Settings ─────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
